    "dock.apps": {
      "kind": "setting",
      "type": "string-list",
      "pattern": "^/(System/)?Applications/.+\\.app$",
      "store": {
        "domain": "com.apple.dock",
        "key": "persistent-apps"
      },
      "apply": "restart-dock"
    },
    "dock.autohide": {
      "kind": "setting",
      "type": "boolean",
      "store": {
        "domain": "com.apple.dock",
        "key": "autohide"
      },
      "apply": "restart-dock"
    },
    "dock.position": {
      "kind": "setting",
      "type": "string",
      "values": {
        "bottom": "bottom",
        "left": "left",
        "right": "right"
