{
  "$schema": "https://raw.githubusercontent.com/nullaroni/soulcaster/main/schema/config-1.schema.json",
  "schemaVersion": 1,
  "name": "Full-stack laptop",
  "items": [
    "claude-code",
    "codex",
    "ghostty",
    "git-identity",
    "opencode",
    "tailscale",
    "xcode"
  ],
  "packages": {
    "formulae": [
      "fd",
      "jq",
      "node",
      "ripgrep",
      "uv"
    ],
    "casks": [
      "firefox",
      "rectangle",
      "visual-studio-code"
    ]
  },
  "settings": {
    "dock.autohide": true,
    "dock.position": "bottom",
    "finder.show-path-bar": true,
    "keyboard.key-repeat": 2,
    "trackpad.tap-to-click": true
  },
  "dotfiles": {
    "repo": "https://git.example.com/dev/dotfiles",
    "links": {
      "~/.config/nvim": "nvim",
      "~/.zshrc": "zsh/zshrc",
      "~/Library/Application Support/Code/User/settings.json": "vscode/settings.json"
    },
    "installScript": "script/setup"
  }
}
