      ],
      "facts": [
        {
          "id": "accessibility",
          "label": "Accessibility permission",
          "probe": {
            "type": "unknowable",
            "reason": "macOS 27 doesn't let apps read the privacy database."
          }
        }
      ],
      "steps": [
        {
          "type": "brew-cask",
          "name": "nikitabobko/tap/aerospace"
        },
        {
          "type": "needs-you",
          "id": "grant-accessibility",
          "text": "Allow AeroSpace under Accessibility in System Settings.",
          "link": "x-apple.systempreferences:com.apple.settings.PrivacySecurity.extension?Privacy_Accessibility",
          "completion": {
            "confirm": true
          }
        }
      ],
      "coversPackages": [
        "cask:nikitabobko/tap/aerospace"
      ]
    },
