{
  "_prototype": "Shared by check.py, check-ajv.mjs and the Rust harness, so all three answer the same questions. check.py expands this into a corpus the other two read.",
  "schemaCases": [
    {"label": "refuses a schemaVersion written as a string", "valid": false, "fields": {"schemaVersion": "1"}},
    {"label": "refuses a schemaVersion of 2", "valid": false, "fields": {"schemaVersion": 2}},
    {"label": "refuses an empty name", "valid": false, "fields": {"name": ""}},
    {"label": "refuses a name with a terminal escape", "valid": false, "fields": {"name": "ok\u001b[2Jsafe"}},
    {"label": "refuses a name with a right-to-left override", "valid": false, "fields": {"name": "ok\u202egnp"}},
    {"label": "refuses a name with a C1 control", "valid": false, "fields": {"name": "ok\u009bx"}},
    {"label": "refuses a name with a zero-width space", "valid": false, "fields": {"name": "ok\u200bx"}},
    {"label": "refuses a name with a line separator", "valid": false, "fields": {"name": "ok\u2028x"}},
    {"label": "refuses a name with an invisible tag character", "valid": false, "fields": {"name": "ok\udb40\udc01x"}},
    {"label": "refuses a name with a leading space", "valid": false, "fields": {"name": " x"}},
    {"label": "refuses a name with a trailing no-break space", "valid": false, "fields": {"name": "x\u00a0"}},
    {"label": "refuses a name of 81 characters", "valid": false, "fields": {"name": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"}},
    {"label": "accepts a name of 80 characters", "valid": true, "fields": {"name": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"}},
    {"label": "accepts a name with accents and an emoji", "valid": true, "fields": {"name": "\u00dcbersicht Mac \ud83d\udda5"}},
    {"label": "accepts an item ID", "valid": true, "fields": {"items": ["ghostty"]}},
    {"label": "refuses a setting ID in items", "valid": false, "fields": {"items": ["dock.autohide"]}},
    {"label": "refuses an uppercase item ID", "valid": false, "fields": {"items": ["Ghostty"]}},
    {"label": "refuses an item ID ending in a newline", "valid": false, "fields": {"items": ["ghostty\n"]}},
    {"label": "refuses a repeated item", "valid": false, "fields": {"items": ["ghostty", "ghostty"]}},
    {"label": "refuses a formula starting with a dash", "valid": false, "fields": {"packages": {"formulae": ["-x"]}}},
    {"label": "refuses a formula with a space", "valid": false, "fields": {"packages": {"formulae": ["rip grep"]}}},
    {"label": "refuses an uppercase formula", "valid": false, "fields": {"packages": {"formulae": ["RipGrep"]}}},
    {"label": "refuses a second spelling of a core formula", "valid": false, "fields": {"packages": {"formulae": ["homebrew/core/ripgrep"]}}},
    {"label": "refuses a tap segment starting homebrew-", "valid": false, "fields": {"packages": {"formulae": ["jetbrains/homebrew-utils/kotlin-lsp"]}}},
    {"label": "refuses a cask tap segment starting homebrew-", "valid": false, "fields": {"packages": {"casks": ["acme/homebrew-tools/widget"]}}},
    {"label": "refuses a formula ending in a newline", "valid": false, "fields": {"packages": {"formulae": ["ripgrep\n"]}}},
    {"label": "refuses a cask ending in a newline", "valid": false, "fields": {"packages": {"casks": ["firefox\n"]}}},
    {"label": "refuses a package shaped like a Ruby file", "valid": false, "fields": {"packages": {"formulae": ["evil.rb"]}}},
    {"label": "refuses a third-party package shaped like a Ruby file", "valid": false, "fields": {"packages": {"formulae": ["a/b/evil.rb"]}}},
    {"label": "refuses a package with two dots", "valid": false, "fields": {"packages": {"formulae": ["a..b"]}}},
    {"label": "refuses a package with options", "valid": false, "fields": {"packages": {"formulae": [{"name": "ripgrep", "args": ["--HEAD"]}]}}},
    {"label": "refuses a version pin field", "valid": false, "fields": {"packages": {"formulae": ["ripgrep"], "versions": {"ripgrep": "14"}}}},
    {"label": "refuses a taps list, dropped from version 1", "valid": false, "fields": {"packages": {"taps": ["example/tools"]}}},
    {"label": "accepts a formula with @ and +", "valid": true, "fields": {"packages": {"formulae": ["openssl@3", "bonnie++"]}}},
    {"label": "accepts a third-party cask", "valid": true, "fields": {"packages": {"casks": ["nikitabobko/tap/aerospace"]}}},
    {"label": "accepts a tap repo name with a dot", "valid": true, "fields": {"packages": {"formulae": ["example/homebrew.tools/widget"]}}},
    {"label": "accepts an alias, which metadata resolves later", "valid": true, "fields": {"packages": {"formulae": ["nvim"]}}},
    {"label": "accepts a package named like a base Item, which is ignored later", "valid": true, "fields": {"packages": {"formulae": ["gh"]}}},
    {"label": "accepts a third-party package named like a base Item, which warns later", "valid": true, "fields": {"packages": {"formulae": ["evil/tap/gh"]}}},
    {"label": "refuses a nested object as a value", "valid": false, "fields": {"settings": {"dock.autohide": {"enabled": true}}}},
    {"label": "refuses a null value", "valid": false, "fields": {"settings": {"dock.autohide": null}}},
    {"label": "refuses a value with a newline", "valid": false, "fields": {"settings": {"example.value": "a\nb"}}},
    {"label": "refuses a value with a right-to-left override", "valid": false, "fields": {"settings": {"example.value": "a\u202eb"}}},
    {"label": "refuses a list holding a number", "valid": false, "fields": {"settings": {"example.value": ["a", 1]}}},
    {"label": "refuses a list with a repeat", "valid": false, "fields": {"settings": {"example.value": ["a", "a"]}}},
    {"label": "refuses a string value of 257 characters", "valid": false, "fields": {"settings": {"example.value": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"}}},
    {"label": "accepts a string value of 256 characters", "valid": true, "fields": {"settings": {"example.value": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"}}},
    {"label": "refuses a setting ID with one segment", "valid": false, "fields": {"settings": {"autohide": true}}},
    {"label": "refuses a setting ID ending in a newline", "valid": false, "fields": {"settings": {"dock.autohide\n": true}}},
    {"label": "accepts a dotted version string", "valid": true, "fields": {"settings": {"example.value": "35.0.0"}}},
    {"label": "accepts a locale that looks like a token prefix", "valid": true, "fields": {"settings": {"system.locale": "sk-SK"}}},
    {"label": "accepts a secret-looking key, which lint handles", "valid": true, "fields": {"settings": {"screensaver.require-password": true}}},
    {"label": "accepts safari.autofill-passwords", "valid": true, "fields": {"settings": {"safari.autofill-passwords": false}}},
    {"label": "accepts ssh.auth-sock", "valid": true, "fields": {"settings": {"ssh.auth-sock": "~/.1password/agent.sock"}}},
    {"label": "accepts a token-shaped value, which lint handles", "valid": true, "fields": {"settings": {"example.value": "ghp_notARealToken"}}},
    {"label": "accepts an email, which lint handles", "valid": true, "fields": {"settings": {"example.value": "you@example.com"}}},
    {"label": "accepts a home-folder path, which lint handles", "valid": true, "fields": {"settings": {"example.value": "/Users/me/Pictures"}}},
    {"label": "accepts an absolute app path outside /Applications, which lint handles", "valid": true, "fields": {"settings": {"dock.apps": ["/Users/me/Applications/Foo.app"]}}},
    {"label": "refuses a repo over ssh", "valid": false, "fields": {"dotfiles": {"repo": "git@github.com:example/dotfiles.git"}}},
    {"label": "refuses a repo over http", "valid": false, "fields": {"dotfiles": {"repo": "http://github.com/example/dotfiles"}}},
    {"label": "refuses a repo that climbs with ..", "valid": false, "fields": {"dotfiles": {"repo": "example/.."}}},
    {"label": "refuses a repo URL that climbs with ..", "valid": false, "fields": {"dotfiles": {"repo": "https://git.example.com/a/../b"}}},
    {"label": "refuses a repo URL with credentials", "valid": false, "fields": {"dotfiles": {"repo": "https://me:pw@github.com/example/dotfiles"}}},
    {"label": "refuses a repo URL with a query", "valid": false, "fields": {"dotfiles": {"repo": "https://github.com/example/dotfiles?x=1"}}},
    {"label": "refuses a repo starting with a dash", "valid": false, "fields": {"dotfiles": {"repo": "example/--upload-pack"}}},
    {"label": "refuses a repo ending in a newline", "valid": false, "fields": {"dotfiles": {"repo": "example/dotfiles\n"}}},
    {"label": "refuses a repo URL of 513 characters", "valid": false, "fields": {"dotfiles": {"repo": "https://git.example."}}},
    {"label": "accepts a repo URL with a port", "valid": true, "fields": {"dotfiles": {"repo": "https://git.example.com:8443/dev/dotfiles"}}},
    {"label": "accepts a repo URL ending in .git", "valid": true, "fields": {"dotfiles": {"repo": "https://git.example.com/dev/dotfiles.git"}}},
    {"label": "accepts a repo named .github", "valid": true, "fields": {"dotfiles": {"repo": "example/.github"}}},
    {"label": "refuses dotfiles with no repo", "valid": false, "fields": {"dotfiles": {"links": {"~/.zshrc": "zsh/zshrc"}}}},
    {"label": "refuses a link target using $HOME", "valid": false, "fields": {"dotfiles": {"repo": "example/dotfiles", "links": {"$HOME/.zshrc": "zsh/zshrc"}}}},
    {"label": "refuses an absolute link target", "valid": false, "fields": {"dotfiles": {"repo": "example/dotfiles", "links": {"/etc/zshrc": "zsh/zshrc"}}}},
    {"label": "refuses the home folder as a target", "valid": false, "fields": {"dotfiles": {"repo": "example/dotfiles", "links": {"~/": "zsh/zshrc"}}}},
    {"label": "refuses a link target climbing out of home", "valid": false, "fields": {"dotfiles": {"repo": "example/dotfiles", "links": {"~/a/../../etc/zshrc": "zsh/zshrc"}}}},
    {"label": "refuses a link target with a trailing slash", "valid": false, "fields": {"dotfiles": {"repo": "example/dotfiles", "links": {"~/.zshrc/": "zsh/zshrc"}}}},
    {"label": "refuses a link target with a double slash", "valid": false, "fields": {"dotfiles": {"repo": "example/dotfiles", "links": {"~//.zshrc": "zsh/zshrc"}}}},
    {"label": "refuses a link target with a trailing space", "valid": false, "fields": {"dotfiles": {"repo": "example/dotfiles", "links": {"~/.zshrc ": "zsh/zshrc"}}}},
    {"label": "refuses a link segment with a leading space", "valid": false, "fields": {"dotfiles": {"repo": "example/dotfiles", "links": {"~/ .ssh/config": "zsh/zshrc"}}}},
    {"label": "refuses a link segment with a trailing no-break space", "valid": false, "fields": {"dotfiles": {"repo": "example/dotfiles", "links": {"~/.ssh\u00a0/config": "zsh/zshrc"}}}},
    {"label": "refuses a link target inside .git", "valid": false, "fields": {"dotfiles": {"repo": "example/dotfiles", "links": {"~/repo/.git/config": "zsh/zshrc"}}}},
    {"label": "refuses a link target inside .GIT", "valid": false, "fields": {"dotfiles": {"repo": "example/dotfiles", "links": {"~/repo/.GIT/config": "zsh/zshrc"}}}},
    {"label": "refuses a link target with a backtick", "valid": false, "fields": {"dotfiles": {"repo": "example/dotfiles", "links": {"~/`x`": "zsh/zshrc"}}}},
    {"label": "refuses a link target with a right-to-left override", "valid": false, "fields": {"dotfiles": {"repo": "example/dotfiles", "links": {"~/a\u202eb": "zsh/zshrc"}}}},
    {"label": "refuses a link target ending in a newline", "valid": false, "fields": {"dotfiles": {"repo": "example/dotfiles", "links": {"~/.zshrc\n": "zsh/zshrc"}}}},
    {"label": "refuses a link target of 257 characters", "valid": false, "fields": {"dotfiles": {"repo": "example/dotfiles", "links": {"~/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx": "zsh/zshrc"}}}},
    {"label": "refuses a link source climbing out of the repo", "valid": false, "fields": {"dotfiles": {"repo": "example/dotfiles", "links": {"~/.zshrc": "zsh/../../secret"}}}},
    {"label": "refuses a link source starting with a dash", "valid": false, "fields": {"dotfiles": {"repo": "example/dotfiles", "links": {"~/.zshrc": "-x"}}}},
    {"label": "refuses a link source starting with ~", "valid": false, "fields": {"dotfiles": {"repo": "example/dotfiles", "links": {"~/.zshrc": "~/secret"}}}},
    {"label": "refuses a link source inside .git", "valid": false, "fields": {"dotfiles": {"repo": "example/dotfiles", "links": {"~/.zshrc": ".git/config"}}}},
    {"label": "refuses a link source ending in a newline", "valid": false, "fields": {"dotfiles": {"repo": "example/dotfiles", "links": {"~/.zshrc": "zsh\n"}}}},
    {"label": "refuses an install script climbing out of the repo", "valid": false, "fields": {"dotfiles": {"repo": "example/dotfiles", "installScript": "../install.sh"}}},
    {"label": "refuses an install script starting with a dash", "valid": false, "fields": {"dotfiles": {"repo": "example/dotfiles", "installScript": "--upload-pack=x"}}},
    {"label": "refuses an install script path with a space, which could be an argument", "valid": false, "fields": {"dotfiles": {"repo": "example/dotfiles", "installScript": "install.sh --yes"}}},
    {"label": "refuses an install script inside .git", "valid": false, "fields": {"dotfiles": {"repo": "example/dotfiles", "installScript": ".git/hooks/post-checkout"}}},
    {"label": "refuses an install script ending in a newline", "valid": false, "fields": {"dotfiles": {"repo": "example/dotfiles", "installScript": "install.sh\n"}}},
    {"label": "refuses a commit pin in dotfiles", "valid": false, "fields": {"dotfiles": {"repo": "example/dotfiles", "commit": "abc"}}},
    {"label": "accepts a link target with spaces", "valid": true, "fields": {"dotfiles": {"repo": "example/dotfiles", "links": {"~/Library/Application Support/Code/User/settings.json": "vscode/settings.json"}}}},
    {"label": "accepts a hidden link source", "valid": true, "fields": {"dotfiles": {"repo": "example/dotfiles", "links": {"~/.zshrc": ".zshrc"}}}},
    {"label": "accepts a link in com~apple~CloudDocs", "valid": true, "fields": {"dotfiles": {"repo": "example/dotfiles", "links": {"~/Library/Mobile Documents/com~apple~CloudDocs/notes": "zsh/zshrc"}}}},
    {"label": "accepts a link with non-ASCII letters", "valid": true, "fields": {"dotfiles": {"repo": "example/dotfiles", "links": {"~/.config/\u00dcbersicht": "\u00fcbersicht"}}}},
    {"label": "accepts a link with parentheses", "valid": true, "fields": {"dotfiles": {"repo": "example/dotfiles", "links": {"~/Library/Application Support/Foo (Beta)/config": "zsh/zshrc"}}}},
    {"label": "accepts a link to a protected folder, which lint handles", "valid": true, "fields": {"dotfiles": {"repo": "example/dotfiles", "links": {"~/Documents": "zsh/zshrc"}}}},
    {"label": "accepts a segment that only starts with .git", "valid": true, "fields": {"dotfiles": {"repo": "example/dotfiles", "links": {"~/.gitconfig": "zsh/zshrc"}}}},
    {"label": "accepts a $schema that's a local path", "valid": true, "fields": {"$schema": "../schema/config-1.schema.json"}},
    {"label": "accepts a $schema from a renamed repo", "valid": true, "fields": {"$schema": "https://raw.githubusercontent.com/someone/renamed/main/config.json"}},
    {"label": "refuses a non-string $schema", "valid": false, "fields": {"$schema": 1}},
    {"label": "accepts a Config with nothing but its version and name", "valid": true, "fields": {}}
  ],
  "sizeCases": [
    {"label": "500 items", "path": ["items"], "template": "item-{}", "count": 500, "valid": true},
    {"label": "501 items", "path": ["items"], "template": "item-{}", "count": 501, "valid": false},
    {"label": "1000 formulae", "path": ["packages", "formulae"], "template": "f{}", "count": 1000, "valid": true},
    {"label": "1001 formulae", "path": ["packages", "formulae"], "template": "f{}", "count": 1001, "valid": false},
    {"label": "1001 casks", "path": ["packages", "casks"], "template": "c{}", "count": 1001, "valid": false},
    {"label": "500 settings", "path": ["settings"], "template": "example.s{}", "count": 500, "valid": true, "map": true},
    {"label": "501 settings", "path": ["settings"], "template": "example.s{}", "count": 501, "valid": false, "map": true},
    {"label": "200 strings in a list value", "path": ["settings", "example.list"], "template": "v{}", "count": 200, "valid": true},
    {"label": "201 strings in a list value", "path": ["settings", "example.list"], "template": "v{}", "count": 201, "valid": false},
    {"label": "501 links", "path": ["dotfiles", "links"], "template": "~/.config/l{}", "count": 501, "valid": false, "map": true, "repo": true}
  ],
  "parserCases": [
    {"label": "plain JSON", "text": "{\"schemaVersion\":1,\"name\":\"x\"}", "valid": true},
    {"label": "a duplicate key", "text": "{\"schemaVersion\":1,\"name\":\"x\",\"name\":\"y\"}", "valid": false},
    {"label": "a duplicate schemaVersion, which keeps the last value", "text": "{\"schemaVersion\":99,\"schemaVersion\":1,\"name\":\"x\"}", "valid": false},
    {"label": "a nested duplicate key", "text": "{\"schemaVersion\":1,\"name\":\"x\",\"settings\":{\"a.b\":1,\"a.b\":2}}", "valid": false},
    {"label": "NaN", "text": "{\"schemaVersion\":1,\"name\":\"x\",\"settings\":{\"a.b\":NaN}}", "valid": false},
    {"label": "Infinity", "text": "{\"schemaVersion\":1,\"name\":\"x\",\"settings\":{\"a.b\":Infinity}}", "valid": false},
    {"label": "-Infinity", "text": "{\"schemaVersion\":1,\"name\":\"x\",\"settings\":{\"a.b\":-Infinity}}", "valid": false},
    {"label": "1e999", "text": "{\"schemaVersion\":1,\"name\":\"x\",\"settings\":{\"a.b\":1e999}}", "valid": false},
    {"label": "an integer too large for a double", "text": "{\"schemaVersion\":1,\"name\":\"x\",\"settings\":{\"a.b\":}}", "valid": false},
    {"label": "a large but finite number", "text": "{\"schemaVersion\":1,\"name\":\"x\",\"settings\":{\"a.b\":1e308}}", "valid": true},
    {"label": "a lone surrogate", "text": "{\"schemaVersion\":1,\"name\":\"x\\ud800\"}", "valid": false},
    {"label": "a byte order mark", "text": "\ufeff{\"schemaVersion\":1,\"name\":\"x\"}", "valid": false},
    {"label": "a trailing comma", "text": "{\"schemaVersion\":1,\"name\":\"x\",}", "valid": false},
    {"label": "a comment", "text": "{\"schemaVersion\":1,\"name\":\"x\"} // no", "valid": false},
    {"label": "text after the value", "text": "{\"schemaVersion\":1,\"name\":\"x\"} {}", "valid": false},
    {"label": "100,000 levels of nesting", "text": "[", "repeat": 100000, "valid": false},
    {"label": "a file of exactly 1 MiB", "text": "{\"schemaVersion\":1,\"name\":\"x\"}", "padTo": 1048576, "valid": true},
    {"label": "a file one byte over 1 MiB", "text": "{\"schemaVersion\":1,\"name\":\"x\"}", "padTo": 1048577, "valid": false}
  ]
}
